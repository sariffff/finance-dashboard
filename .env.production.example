# ค่าสำหรับ production (docker-compose.prod.yml) — บนเซิร์ฟเวอร์ให้คัดลอกเป็น .env.production
# แล้วเปลี่ยนทุกค่า "change-me" — ห้าม commit ไฟล์ .env.production

# โดเมนที่ชี้ (DNS A record) มายัง IP ของเซิร์ฟเวอร์แล้ว — ใช้ localhost เพื่อทดสอบในเครื่อง
DOMAIN=finance.example.com

# รหัสผ่าน database: ใช้ตัวอักษร/ตัวเลขเท่านั้น (ใส่ใน URL ได้โดยไม่ต้อง escape)
# สร้างด้วย: openssl rand -hex 24
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finance

# สร้างด้วย: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-secret

DEMO_USER_EMAIL=demo@finance.local
DEMO_USER_PASSWORD=demo-password-1234

# AI: ใส่ key อย่างน้อยหนึ่งตัว (ไม่ใส่เลย = จัดหมวดด้วยกฎอย่างเดียว)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# ว่าง = เลือกตาม key ที่มี — รายชื่อโมเดลดูใน .env.example
AI_MODEL=

# Cloudflare R2 (bucket แบบ private) — ไม่ใส่ = ไม่เก็บไฟล์ต้นฉบับ
# รูปแบบ: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=finance-dashboard
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
