# คัดลอกไฟล์นี้เป็น .env แล้วเปลี่ยนรหัสผ่าน (อย่า commit ไฟล์ .env ขึ้น Git)
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finance

# Next.js + Drizzle ใช้ค่านี้เชื่อมต่อ database
DATABASE_URL=postgres://finance:change-me@localhost:5433/finance

# Better Auth — secret ใช้เข้ารหัส session (สร้างด้วย: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000

# บัญชีตัวอย่าง (demo) — รหัสนี้ถือว่าเปิดเผย ใช้เก็บข้อมูล seed เท่านั้น
DEMO_USER_EMAIL=demo@finance.local
DEMO_USER_PASSWORD=demo-password-1234

# AI — ใช้จัดหมวดหมู่อัตโนมัติ, อ่านสลิป, สรุปรายเดือน (ไม่ใส่ key เลยก็ได้ ระบบจะใช้แค่กฎ)
# ใส่ key ของผู้ให้บริการที่ใช้ อย่างน้อยหนึ่งตัว
# Claude: https://console.anthropic.com · Gemini: https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# โมเดลที่ใช้ — ชื่อโมเดลบอกเองว่าใช้ผู้ให้บริการไหน
#   Claude: claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5, claude-fable-5-1
#   Gemini: gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.8-flash
# ว่างไว้ = เลือกให้เองตาม key ที่มี (claude-opus-5-5 หรือ gemini-3.5-flash)
# AI_MODEL ใช้กับทุกงาน ถ้าอยากแยกต่องานให้ใส่ AI_MODEL_<งาน> (ว่างไว้ = ใช้ AI_MODEL)
# ผสมได้ เช่น AI_MODEL=gemini-3.5-flash-lite กับ AI_MODEL_SLIP=claude-opus-5-5 (ต้องมี key ของทั้งคู่)
AI_MODEL=
AI_MODEL_CATEGORIZE=
AI_MODEL_SLIP=
AI_MODEL_INSIGHTS=

# ที่เก็บไฟล์ (S3 API) — ไม่ใส่ก็ได้ (ระบบจะไม่เก็บไฟล์ต้นฉบับ)
# ตอนพัฒนา: RustFS ใน Docker (docker compose up -d) — ค่า key นี้ใช้ตั้งรหัสให้ RustFS ด้วย
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto, S3_FORCE_PATH_STYLE=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=finance-dashboard
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me-to-a-long-random-secret
S3_FORCE_PATH_STYLE=true

# Vercel Cron: รีเซ็ตบัญชี demo ทุกวัน (/api/cron/reset-demo) — ใส่เฉพาะบน Vercel (สร้างด้วย: openssl rand -hex 32)
CRON_SECRET=
