# ค่าสำหรับเซิร์ฟเวอร์จริง — บนเซิร์ฟเวอร์ให้คัดลอกเป็น .env ที่ root ของโปรเจกต์:
#   cp deploy/env.production.example .env && chmod 600 .env
# ห้าม commit .env (อยู่ใน .gitignore แล้ว)
#
# รหัสผ่าน/secret ให้สุ่มด้วย openssl (ใช้แบบ hex เพื่อไม่มีอักขระพิเศษที่ทำให้ URL พัง):
#   openssl rand -hex 32

# โดเมนของเว็บ (ชี้ DNS A record มาที่ IP ของเซิร์ฟเวอร์ก่อน) — ทดสอบในเครื่องใช้ localhost
DOMAIN=finance.example.com

# Database — DATABASE_URL ประกอบให้อัตโนมัติใน docker-compose.prod.yml ไม่ต้องใส่เอง
POSTGRES_USER=finance
POSTGRES_PASSWORD=
POSTGRES_DB=finance

# Better Auth — BETTER_AUTH_URL = https://$DOMAIN ตั้งให้อัตโนมัติ
BETTER_AUTH_SECRET=

# บัญชีตัวอย่างสำหรับปุ่ม "ลองใช้ด้วยบัญชีตัวอย่าง" — รหัสนี้ถือว่าเปิดเผย
DEMO_USER_EMAIL=demo@finance.local
DEMO_USER_PASSWORD=demo-password-1234

# Claude API (ไม่ใส่ = จัดหมวดด้วยกฎอย่างเดียว, อ่านสลิปไม่ได้)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MODEL_CATEGORIZE=
AI_MODEL_SLIP=
AI_MODEL_INSIGHTS=

# ที่เก็บไฟล์ต้นฉบับ: Cloudflare R2 (bucket แบบ private) — ว่างไว้ = ไม่เก็บไฟล์ต้นฉบับ
# endpoint ต้องเข้าถึงได้จากเบราว์เซอร์ เพราะลิงก์ดาวน์โหลดเป็น signed URL ที่ชี้ไปที่ R2 โดยตรง
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
